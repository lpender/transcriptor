# Cloudflare Pages headers for the app (tablework.com). The service worker and
# the entry page must never be cached by the edge, or a deploy is invisible
# until the next SW cycle; everything else may be.
/sw.js
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/
  Cache-Control: no-cache
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
